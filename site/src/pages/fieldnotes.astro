    .fn-cmd code { overflow-wrap: anywhere; }
    .fn-request { font-size: 1.05rem; }
    .fn-faq-item summary { font-size: 1.25rem; }
  }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('[data-ask-demo]');
  if (demo) {
    const buttons = Array.from(demo.querySelectorAll<HTMLButtonElement>('button[data-request]'));
    const states = Array.from(demo.querySelectorAll<HTMLElement>('[data-state]'));
    const status = demo.querySelector<HTMLElement>('[data-demo-status]');
    const select = (id: string | undefined) => {
      let label = '';
      for (const button of buttons) {
        const pressed = button.dataset.request === id;
        button.setAttribute('aria-pressed', String(pressed));
        if (pressed) label = button.dataset.label ?? '';
      }
      for (const state of states) state.hidden = state.dataset.state !== id;
      if (status) status.textContent = `Showing ${label}`;
    };
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => select(button.dataset.request));
      button.addEventListener('keydown', (event) => {
        const forward = event.key === 'ArrowDown' || event.key === 'ArrowRight';
        const backward = event.key === 'ArrowUp' || event.key === 'ArrowLeft';
        if (!forward && !backward) return;
        event.preventDefault();
        const next = buttons[(index + (forward ? 1 : -1) + buttons.length) % buttons.length];
        next.focus();
        select(next.dataset.request);
      });
    });
  }

  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    const idle = button.textContent;
    let reset = 0;
    button.addEventListener('click', async () => {
      const text = button.dataset.copy ?? '';
      try {
        if (!navigator.clipboard || !window.isSecureContext) throw new Error('clipboard unavailable');
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
        if (copyStatus) copyStatus.textContent = `Copied “${text}” to the clipboard.`;
      } catch {
        button.textContent = 'Not copied';
        if (copyStatus) copyStatus.textContent = `Couldn’t reach the clipboard here. Select “${text}” and copy it yourself.`;
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => { button.textContent = idle; }, 2400);
    });
  }
</script>

<script>
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    const idle = button.textContent ?? 'Copy';
    let reset = 0;
    button.addEventListener('click', async () => {
      const text = button.dataset.copy ?? '';
      let copied = false;
      try {
        if (!window.isSecureContext || !navigator.clipboard) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch {
        // Denied or unavailable: select the command so it can be copied by hand.
        const code = button.closest('[data-command]')?.querySelector('code');
        if (code) window.getSelection()?.selectAllChildren(code);
      }
      button.textContent = copied ? 'Copied' : 'Not copied';
      button.dataset.result = copied ? 'copied' : 'denied';
      if (copyStatus) {
        copyStatus.textContent = copied
          ? `Copied “${text}” to the clipboard.`
          : `Clipboard access was blocked, so “${text}” is selected instead. Copy it with Ctrl+C or ⌘C.`;
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.textContent = idle;
        delete button.dataset.result;
      }, 2600);
    });
  }
</script>
